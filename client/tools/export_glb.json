{
  "name": "Export glTF/GLB",
  "description": "Re-exports the active scene to a self-contained .glb file. Enables the bundled glTF add-on if needed.",
  "software": "blender",
  "params": [
    {
      "name": "output_path",
      "type": "string",
      "required": true,
      "description": "Destination .glb path."
    },
    {
      "name": "yup",
      "type": "boolean",
      "default": true,
      "description": "Export using +Y up (glTF convention)."
    },
    {
      "name": "draco",
      "type": "boolean",
      "default": false,
      "description": "Apply Draco mesh compression."
    },
    {
      "name": "export_apply",
      "type": "boolean",
      "default": true,
      "description": "Apply modifiers before exporting."
    }
  ]
}
