{
    // Launch configurations for the standalone Blendkit-Client (Go).
    // "Run/Debug/Test Client" require the Go extension (golang.go) and Delve.
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Run Project Setup",
            "type": "node",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "windows": {
                "runtimeExecutable": "${workspaceFolder}/.vscode/pdm_setup_project.bat",
            },
            "linux": {
                "runtimeExecutable": "${workspaceFolder}/.vscode/pdm_setup_project.sh",
            },
            "osx": {
                "runtimeExecutable": "${workspaceFolder}/.vscode/pdm_setup_project.sh",
            }
        },

        {
            // Build the Client from source and run it standalone (no DCC).
            // Add flags under "args", e.g. ["--port", "62000", "--server", "https://devel.blendkit.com"].
            "name": "Run Client (standalone)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/client",
            "cwd": "${workspaceFolder}/client",
            "args": []
        },
        {
            // Same as above but stops in the debugger; set breakpoints in the .go files.
            "name": "Debug Client (standalone)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/client",
            "cwd": "${workspaceFolder}/client",
            "args": []
        },
        {
            // Build for the current platform via dev.py and run the binary solo.
            // Standalone => automatic tray icon (Windows), single-instance, no
            // auto-shutdown. Set BLENDKIT_SERVER in .env to target devel.
            "name": "Build + Run Client (dev.py)",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dev.py",
            "args": [
                "run"
            ]
        },
        {
            // Run the live-tagged Go integration tests using credentials from .env.
            "name": "Live tests (.env)",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dev.py",
            "args": [
                "live"
            ]
        },
        {
            // Run all Go unit tests (incl. the API drift test).
            "name": "Test Client (go test)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/client/...",
            "cwd": "${workspaceFolder}/client"
        },
        {
            // Cross-compile the Client for every shipped platform into ./out/vX.Y.Z/.
            "name": "Build Client (all platforms)",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dev.py",
            "args": [
                "build"
            ]
        },

        {
            "name": "[GOFMT] Check client",
            "type": "node",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "windows": {
                "runtimeExecutable": "powershell",
                "args": [
                    "-NoLogo",
                    "-NoProfile",
                    "-Command",
                    "$fmt = gofmt -l ./client; if ($fmt) { Write-Host 'Go files need formatting:'; $fmt; Write-Host ''; Write-Host 'gofmt diff:'; gofmt -d ./client; exit 1 } else { Write-Host 'Go files are formatted.' }"
                ]
            },
            "linux": {
                "runtimeExecutable": "/bin/bash",
                "args": [
                    "-c",
                    "fmt_out=\"$(gofmt -l ./client)\"; if [ -n \"$fmt_out\" ]; then echo 'Go files need formatting:'; echo \"$fmt_out\"; echo ''; echo 'gofmt diff:'; gofmt -d ./client; exit 1; else echo 'Go files are formatted.'; fi"
                ]
            },
            "osx": {
                "runtimeExecutable": "/bin/bash",
                "args": [
                    "-c",
                    "fmt_out=\"$(gofmt -l ./client)\"; if [ -n \"$fmt_out\" ]; then echo 'Go files need formatting:'; echo \"$fmt_out\"; echo ''; echo 'gofmt diff:'; gofmt -d ./client; exit 1; else echo 'Go files are formatted.'; fi"
                ]
            }
        },

        {
            "name": "[GOFMT] Fix client",
            "type": "node",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "windows": {
                "runtimeExecutable": "powershell",
                "args": [
                    "-NoLogo",
                    "-NoProfile",
                    "-Command",
                    "$fmt = gofmt -w ./client; if ($fmt) { Write-Host 'Go files need formatting:'; $fmt; Write-Host ''; Write-Host 'gofmt diff:'; gofmt -d ./client; exit 1 } else { Write-Host 'Go files are formatted.' }"
                ]
            },
            "linux": {
                "runtimeExecutable": "/bin/bash",
                "args": [
                    "-c",
                    "fmt_out=\"$(gofmt -w ./client)\"; if [ -n \"$fmt_out\" ]; then echo 'Go files need formatting:'; echo \"$fmt_out\"; echo ''; echo 'gofmt diff:'; gofmt -d ./client; exit 1; else echo 'Go files are formatted.'; fi"
                ]
            },
            "osx": {
                "runtimeExecutable": "/bin/bash",
                "args": [
                    "-c",
                    "fmt_out=\"$(gofmt -w ./client)\"; if [ -n \"$fmt_out\" ]; then echo 'Go files need formatting:'; echo \"$fmt_out\"; echo ''; echo 'gofmt diff:'; gofmt -d ./client; exit 1; else echo 'Go files are formatted.'; fi"
                ]
            }
        },

        {
            "name": "[RUFF] Check All",
            "type": "debugpy",
            "request": "launch",
            "module": "ruff",
            "args": [
                "check",
                "."
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            },
            "linux": {
                "python": "${workspaceFolder}/.venv/bin/python",
            },
            "osx": {
                "python": "${workspaceFolder}/.venv/bin/python",
            }
        },

        {
            "name": "[RUFF] Check All Diff",
            "type": "debugpy",
            "request": "launch",
            "module": "ruff",
            "args": [
                "format",
                "--check",
                "--diff",
                "."
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            },
            "linux": {
                "python": "${workspaceFolder}/.venv/bin/python",
            },
            "osx": {
                "python": "${workspaceFolder}/.venv/bin/python",
            }
        },

        {
            "name": "[RUFF] Fix All",
            "type": "debugpy",
            "request": "launch",
            "module": "ruff",
            "args": [
                "format",
                "."
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            },
            "linux": {
                "python": "${workspaceFolder}/.venv/bin/python",
            },
            "osx": {
                "python": "${workspaceFolder}/.venv/bin/python",
            }
        },

        {
            "name": "[BANDIT] Check All",
            "type": "debugpy",
            "request": "launch",
            "module": "bandit",
            "args": [
                "-c", "_bandit.yaml",
                "-ll",
                "-r", ".",
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            },
            "linux": {
                "python": "${workspaceFolder}/.venv/bin/python",
            },
            "osx": {
                "python": "${workspaceFolder}/.venv/bin/python",
            }
        },

        {
            "name": "[PYDOCS] Check All",
            "type": "node",
            "request": "launch",
            "args": ["."],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",

            "windows": {
                "runtimeExecutable": "${workspaceFolder}/.venv/Scripts/pydoclint.exe",
            },
            "linux": {
                "runtimeExecutable": "${workspaceFolder}/.venv/bin/pydoclint",
            },
            "osx": {
                "runtimeExecutable": "${workspaceFolder}/.venv/bin/pydoclint",
            }
        },
    ]
}
