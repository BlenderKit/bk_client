{
    // Launch configurations for the standalone Blendkit-Client (Go).
    // "Run/Debug/Test Client" require the Go extension (golang.go) and Delve.
    "version": "0.2.0",
    "configurations": [
        {
            // Build the Client from source and run it standalone (no DCC).
            // Add flags under "args", e.g. ["--port", "62000", "--server", "https://devel.blendkit.com"].
            "name": "Run Client (standalone)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/client",
            "cwd": "${workspaceFolder}/client",
            "args": []
        },
        {
            // Same as above but stops in the debugger; set breakpoints in the .go files.
            "name": "Debug Client (standalone)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/client",
            "cwd": "${workspaceFolder}/client",
            "args": []
        },
        {
            // Build for the current platform via dev.py and run the binary solo.
            // Standalone => automatic tray icon (Windows), single-instance, no
            // auto-shutdown. Set BLENDKIT_SERVER in .env to target devel.
            "name": "Build + Run Client (dev.py)",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dev.py",
            "args": [
                "run"
            ]
        },
        {
            // Run the live-tagged Go integration tests using credentials from .env.
            "name": "Live tests (.env)",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dev.py",
            "args": [
                "live"
            ]
        },
        {
            // Run all Go unit tests (incl. the API drift test).
            "name": "Test Client (go test)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/client/...",
            "cwd": "${workspaceFolder}/client"
        },
        {
            // Cross-compile the Client for every shipped platform into ./out/vX.Y.Z/.
            "name": "Build Client (all platforms)",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/dev.py",
            "args": [
                "build"
            ]
        }
    ]
}
